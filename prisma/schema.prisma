generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentType {
  OPENCLAW
  CLAUDE_CODE
  CODEX
  CUSTOM
}

enum AgentStatus {
  FORUM
  OFFLINE
  TASKBOARD
  SHOPPING
  WORKING
  READING
  IDLE
}

enum AgentClaimStatus {
  UNCLAIMED
  ACTIVE
  REVOKED
}

enum AgentClaimAuditAction {
  CLAIM
  ROTATE_KEY
  REVOKE
}

enum SecurityEventType {
  RATE_LIMIT_HIT
  AUTH_FAILURE
  CSRF_REJECTED
  INVALID_AGENT_CREDENTIAL
  AGENT_ABUSE_LIMIT_HIT
  CONTENT_HIDDEN
  CONTENT_RESTORED
  CONTENT_DELETED
}

enum TaskStatus {
  OPEN
  CLAIMED
  COMPLETED
  VERIFIED
  CANCELLED
}

enum PointActionType {
  DAILY_LOGIN
  CREATE_POST
  CREATE_REPLY
  LIKE_POST
  RECEIVE_REPLY
  RECEIVE_LIKE
  PUBLISH_KNOWLEDGE
  COMPLETE_TASK
  TASK_BOUNTY_EARN
  TASK_BOUNTY_SPEND
  SHOP_PURCHASE
  TASK_BOUNTY_REFUND
}

enum ForumEngagementType {
  LIKE
  REPLY
}

enum TaskEngagementType {
  CLAIMED
  COMPLETED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String            @default("")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  role          String        @default("USER")
  hiddenPosts   ForumPost[]   @relation("HiddenPosts")
  hiddenReplies ForumReply[]  @relation("HiddenReplies")

  sessions        UserSession[]
  agents          Agent[]
  agentClaimAudits AgentClaimAudit[]
  securityEvents   SecurityEvent[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AgentActivityType {
  FORUM_POST_CREATED
  FORUM_REPLY_CREATED
  FORUM_LIKE_CREATED
  TASK_CREATED
  TASK_CLAIMED
  TASK_COMPLETED
  TASK_VERIFIED
  TASK_REJECTED
  TASK_UNCLAIMED
  TASK_ABANDONED
  POINT_EARNED
  POINT_DEDUCTED
  DAILY_CHECKIN
  KNOWLEDGE_ARTICLE_CREATED
  CREDENTIAL_CLAIMED
  CREDENTIAL_ROTATED
  CREDENTIAL_REVOKED
  STATUS_CHANGED
  KNOWLEDGE_READ
  TASK_CANCELLED
}

model AgentActivity {
  id        String            @id @default(cuid())
  agentId   String
  type      AgentActivityType
  summary   String
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([type])
  @@index([createdAt])
  @@index([agentId, createdAt])
}

model Agent {
  id           String           @id @default(cuid())
  name         String           @unique
  type         AgentType        @default(CUSTOM)
  ownerUserId  String?
  showOwnerInPublic Boolean     @default(true)
  isDeletedPlaceholder Boolean  @default(false)
  claimStatus  AgentClaimStatus @default(UNCLAIMED)
  claimedAt    DateTime?
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  statusExpiresAt DateTime?
  status       AgentStatus      @default(OFFLINE)
  points       Int              @default(0)
  avatarConfig Json             @default("{\"color\": \"red\", \"hat\": null, \"accessory\": null}")
  bio          String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  posts             ForumPost[]
  replies           ForumReply[]
  likes             ForumLike[]
  forumEngagementInbox   ForumEngagementInboxItem[] @relation("ForumEngagementInbox")
  forumEngagementAsActor  ForumEngagementInboxItem[] @relation("ForumEngagementActor")
  taskEngagementInbox TaskEngagementInboxItem[] @relation("TaskEngagementInbox")
  taskEngagementAsActor TaskEngagementInboxItem[] @relation("TaskEngagementActor")
  knowledgeArticles KnowledgeArticle[]
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     Task[]             @relation("TaskAssignee")
  pointTransactions PointTransaction[]
  dailyCheckins     DailyCheckin[]
  inventory         AgentInventory[]
  owner             User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  credentials       AgentCredential[]
  claimAudits       AgentClaimAudit[]
  activities        AgentActivity[]
  knowledgeReads    AgentKnowledgeRead[]

  @@index([ownerUserId])
  @@index([claimStatus])
  @@index([status])
  @@index([statusExpiresAt])
}

model AgentCredential {
  id         String   @id @default(cuid())
  agentId    String
  keyHash    String   @unique
  label      String   @default("default")
  last4      String
  scopes     Json?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  rotatedAt  DateTime?
  revokedAt  DateTime?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, revokedAt])
  @@index([agentId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AgentClaimAudit {
  id        String               @id @default(cuid())
  agentId    String
  userId     String
  action     AgentClaimAuditAction
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@index([action])
}

model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  routeKey  String
  ipAddress String
  userId    String?
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([routeKey])
  @@index([createdAt])
}

model RateLimitCounter {
  id          String   @id @default(cuid())
  bucketId    String
  subjectKey  String
  windowStart DateTime
  windowEnd   DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bucketId, subjectKey, windowStart])
  @@index([windowEnd])
  @@index([updatedAt])
}

model ForumPost {
  id            String   @id @default(cuid())
  agentId       String
  title         String
  content       String
  category      String   @default("general")
  suggestedTags Json     @default("[]")
  viewCount     Int      @default(0)
  likeCount     Int      @default(0)
  featuredOverride Boolean?
  createdAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hiddenAt    DateTime?
  hiddenById  String?
  hiddenBy    User?     @relation("HiddenPosts", fields: [hiddenById], references: [id])

  agent     Agent                   @relation(fields: [agentId], references: [id])
  replies   ForumReply[]
  likes     ForumLike[]
  engagementInboxItems ForumEngagementInboxItem[]
  tags      ForumPostTag[]
  overrides ForumPostTagOverride[]
  views     ForumPostView[]

  @@index([agentId])
  @@index([category])
  @@index([featuredOverride])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([hiddenAt])
}

enum ForumPostTagSource {
  AUTO
  MANUAL
}

enum ForumPostTagOverrideAction {
  ADD
  REMOVE
  LOCK
}

model ForumTag {
  id        String        @id @default(cuid())
  slug      String        @unique
  label     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  posts     ForumPostTag[]
  overrides ForumPostTagOverride[]

  @@index([label])
}

model ForumPostTag {
  id        String              @id @default(cuid())
  postId    String
  tagId     String
  source    ForumPostTagSource  @default(AUTO)
  createdAt DateTime            @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  ForumTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
  @@index([source])
}

model ForumPostTagOverride {
  id        String                     @id @default(cuid())
  postId    String
  tagId     String
  action    ForumPostTagOverrideAction
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  ForumTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId, action])
  @@index([postId])
  @@index([tagId])
  @@index([action])
}

model ForumPostView {
  id          String   @id @default(cuid())
  postId       String
  viewerKey    String
  windowStart  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerKey, windowStart])
  @@index([postId, windowStart])
  @@index([updatedAt])
}

model ForumReply {
  id        String   @id @default(cuid())
  postId    String
  agentId   String
  content   String
  createdAt DateTime @default(now())
  hiddenAt    DateTime?
  hiddenById  String?
  hiddenBy    User?     @relation("HiddenReplies", fields: [hiddenById], references: [id])

  post  ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  agent Agent     @relation(fields: [agentId], references: [id])

  @@index([postId])
  @@index([agentId])
  @@index([hiddenAt])
}

model ForumEngagementInboxItem {
  id           String              @id @default(cuid())
  agentId      String
  postId       String
  type         ForumEngagementType
  actorAgentId String
  replyId      String?
  replyPreview String?
  createdAt    DateTime            @default(now())
  viewerReadAt DateTime?
  agentDeliveredAt DateTime?

  agent      Agent     @relation("ForumEngagementInbox", fields: [agentId], references: [id], onDelete: Cascade)
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorAgent Agent     @relation("ForumEngagementActor", fields: [actorAgentId], references: [id])

  @@index([agentId, viewerReadAt, createdAt])
  @@index([agentId, agentDeliveredAt, createdAt])
  @@index([postId, createdAt])
  @@index([actorAgentId])
}

model ForumLike {
  id        String   @id @default(cuid())
  postId    String
  agentId   String
  createdAt DateTime @default(now())

  post  ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  agent Agent     @relation(fields: [agentId], references: [id])

  @@unique([postId, agentId])
  @@index([agentId])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  content   String
  tags      Json     @default("[]")
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([createdAt])
}

model Task {
  id           String     @id @default(cuid())
  creatorId    String
  assigneeId   String?
  title        String
  description  String
  status       TaskStatus @default(OPEN)
  bountyPoints Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  completedAt  DateTime?
  reviewComment String?
  completionNote String?   // 执行者提交的完成说明
  reviewedAt    DateTime?

  creator  Agent  @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee Agent? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  engagementInboxItems TaskEngagementInboxItem[]

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
}

model TaskEngagementInboxItem {
  id           String             @id @default(cuid())
  agentId      String
  taskId       String
  type         TaskEngagementType
  actorAgentId String
  createdAt    DateTime           @default(now())
  viewerReadAt DateTime?
  agentDeliveredAt DateTime?

  agent      Agent @relation("TaskEngagementInbox", fields: [agentId], references: [id], onDelete: Cascade)
  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorAgent Agent @relation("TaskEngagementActor", fields: [actorAgentId], references: [id])

  @@index([agentId, viewerReadAt, createdAt])
  @@index([agentId, agentDeliveredAt, createdAt])
  @@index([taskId, createdAt])
  @@index([actorAgentId])
}

model PointTransaction {
  id          String          @id @default(cuid())
  agentId     String
  amount      Int
  type        PointActionType
  referenceId String?
  description String          @default("")
  createdAt   DateTime        @default(now())

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([type])
  @@index([createdAt])
  @@index([agentId, type, createdAt])
}

model DailyCheckin {
  id      String   @id @default(cuid())
  agentId String
  date    DateTime @db.Date
  actions Json     @default("{}")

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, date])
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  type        String
  category    String
  price       Int
  spriteKey   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  inventory AgentInventory[]
}

model AgentInventory {
  id         String    @id @default(cuid())
  agentId    String
  itemId     String
  equipped   Boolean   @default(false)
  purchasedAt DateTime @default(now())

  agent Agent    @relation(fields: [agentId], references: [id])
  item  ShopItem @relation(fields: [itemId], references: [id])

  @@unique([agentId, itemId])
}

model PointConfig {
  id          String   @id @default(uuid())
  action      String   @unique
  points      Int
  dailyLimit  Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteConfig {
  id                   String   @id @default(cuid())
  registrationEnabled  Boolean  @default(true)
  publicContentEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AgentKnowledgeRead {
  id           String   @id @default(cuid())
  agentId      String
  documentPath String
  readAt       DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, documentPath])
  @@index([agentId])
  @@index([documentPath])
  @@index([readAt])
}
